# P13 — Environment configuration example
# Copy this file to .env and adjust values as needed.

# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model to use for the agent
OLLAMA_MODEL=qwen3:8b

# Path to the SQLite demo database
DATABASE_PATH=./data/demo.db

# Maximum rows any single tool call may return (server-side hard cap)
MAX_ROWS=100

# FastAPI server settings
API_HOST=127.0.0.1
API_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
